# Local PostgreSQL (used by docker compose)
POSTGRES_DB=loofio
POSTGRES_USER=loofio
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql://loofio:change-me-for-local-development@localhost:5433/loofio
API_PORT=8000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# Direct OAuth — use a unique, high-entropy value in every environment.
# Generate one locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
